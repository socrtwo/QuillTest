{
  "name": "quilltest",
  "version": "0.1.0",
  "private": true,
  "description": "Anne's Test \u2014 open-source web application security testing and fixing tool, part of the Anne's Office suite. Runnable from the CLI: ownership-gated passive scan, stack fingerprinting with EOL/CVE assessment, protocol checks, fix-artifact generation, and multi-provider AI analysis.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Paul D Pruitt",
    "email": "socrtwo@s2services.com"
  },
  "homepage": "https://github.com/socrtwo/QuillTest",
  "repository": {
    "type": "git",
    "url": "https://github.com/socrtwo/QuillTest.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "quilltest-ai-setup": "scripts/ai-setup-wizard.mjs",
    "quilltest-ai-analyze": "scripts/ai-analyze.mjs",
    "quilltest": "scripts/scan.mjs",
    "quilltest-fix": "scripts/fix.mjs",
    "quilltest-report": "scripts/report.mjs",
    "quilltest-mirror": "scripts/mirror.mjs",
    "quilltest-targets": "scripts/targets.mjs",
    "quilltest-commands": "scripts/commands.mjs"
  },
  "scripts": {
    "ai:setup": "node scripts/ai-setup-wizard.mjs",
    "ai:list": "node scripts/ai-setup-wizard.mjs --list",
    "ai:sync-browser": "node scripts/sync-browser-registry.mjs",
    "shell:sync": "node scripts/sync-shell-registry.mjs",
    "test": "node --test",
    "ai:analyze": "node scripts/ai-analyze.mjs",
    "scan": "node scripts/scan.mjs",
    "fix": "node scripts/fix.mjs",
    "report": "node scripts/report.mjs",
    "protocols": "node scripts/scan.mjs protocols",
    "mirror": "node scripts/mirror.mjs",
    "targets": "node scripts/targets.mjs",
    "commands": "node scripts/commands.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder",
    "cap:sync": "vite build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios"
  },
  "keywords": [
    "security",
    "vulnerability-scanner",
    "web-security",
    "owasp",
    "annes-office-suite",
    "ai"
  ],
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "electron": "^40.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.quillsuite.quilltest",
    "productName": "Anne's Test",
    "executableName": "QuillTest",
    "artifactName": "QuillTest-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "scripts/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Security",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    }
  }
}
